# Nexora environment template
# Copy to `.env` and fill in per environment (development / testing / production).

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Release metadata (injected by CI) -------------------------------------
VITE_BUILD_NUMBER=local
VITE_BUILD_COMMIT=dev

# --- Database & auth (Lovable Cloud / Supabase) ----------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application secrets (server-only) -------------------------------------
# 32+ char random value used to encrypt stored device credentials.
DEVICE_CREDENTIAL_SECRET=
# AI gateway key for chat/agent features.
LOVABLE_API_KEY=
